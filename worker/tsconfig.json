{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src/**/*",
    "worker-configuration.d.ts"
  ]
}
