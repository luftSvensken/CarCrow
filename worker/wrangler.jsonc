{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carcrow-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "70401",
      "simple": {
        "limit": 18,
        "period": 60
      }
    },
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "70402",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "MODEL": "nvidia/nemotron-3-super-120b-a12b:free",
    "FALLBACK_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free"
  }
}
